# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*

# Authentication (Shared HS256 secret with Auth Service)
JWT_ACCESS_SECRET=replace_with_a_secure_random_256_bit_secret_string

# Databases
MONGODB_URI=mongodb://localhost:27017/securechat
REDIS_URL=redis://localhost:6379

# Rate Limiting
MESSAGE_RATE_LIMIT_WINDOW_SECS=60
MESSAGE_RATE_LIMIT_MAX=30
